{
  "name": "biotron-web",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.11" },
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "build": "node scripts/build-id.mjs",
    "test": "node --test tests/",
    "test:browser": "node scripts/test-browser.mjs",
    "check:core": "node scripts/sync-core.mjs --check",
    "verify": "npm run check:core && npm run build && npm test && npm run test:browser"
  },
  "dependencies": {
    "@elemaudio/core": "4.0.1",
    "@elemaudio/web-renderer": "4.0.3"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright-core": "1.64.0"
  }
}
