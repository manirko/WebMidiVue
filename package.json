{
  "name": "web-midi-playtronica",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "serve": "vue-cli-service serve",
    "build": "vue-cli-service build",
    "build:biotron-beta": "vue-cli-service build --mode biotron-beta",
    "build:biotron-firmware-beta": "vue-cli-service build --mode biotron-firmware-beta",
    "candidate:biotron": "node scripts/build-biotron-candidate.mjs",
    "lint": "vue-cli-service lint",
    "test:midi-lifecycle": "node scripts/test-midi-lifecycle.js",
    "test:device-scope": "node scripts/test-device-scope.js",
    "test:pwa": "node scripts/test-pwa-build.js",
    "test:production-isolation": "npm run build && node scripts/test-production-isolation.js",
    "test:firmware": "node scripts/test-firmware-update.js",
    "test:pwa:browser": "node scripts/test-pwa-browser.js",
    "test:sound": "node --test scripts/test-sound-core.mjs scripts/test-sound-recovery.js scripts/test-midi-output-lifecycle.mjs scripts/test-elementary-pending.mjs",
    "test:sound:levels": "node scripts/test-sound-elementary.js",
    "test:sound:browser": "node scripts/test-sound-browser.js",
    "test:quality:browser": "node scripts/test-quality-browser.js",
    "test:playtron-variants:browser": "node scripts/test-playtron-variants-browser.js",
    "test:scales-variants:browser": "node scripts/test-scales-variants-browser.js",
    "test:touchme-variants:browser": "node scripts/test-touchme-variants-browser.js",
    "test:navigation": "node scripts/test-navigation-contract.js",
    "test:compatibility": "node scripts/test-compatibility-contract.js",
    "audit:web": "node scripts/audit-web-architecture.mjs",
    "test:architecture": "node scripts/audit-web-architecture.mjs --check",
    "test:listeners": "node --test scripts/test-listener-scope.mjs",
    "test:midi-timing": "node --test scripts/test-midi-timing.mjs",
    "test:settings-readback": "node scripts/test-settings-readback.mjs && node scripts/test-biotron-settings-connection.js",
    "test:diagnostics": "node scripts/test-biotron-diagnostics.mjs",
    "test:telemetry": "node scripts/test-telemetry.mjs",
    "test:release-evidence": "node --test scripts/test-biotron-candidate.mjs",
    "test:preview-guard": "PYTHONDONTWRITEBYTECODE=1 /opt/homebrew/bin/python3 -m unittest scripts.test_biotron_preview_guard",
    "test:legacy-selector": "node scripts/test-legacy-device-selector.js",
    "test:playtron-variants": "node scripts/test-playtron-variants.js",
    "test:scales-variants": "node scripts/test-scales-variants.js",
    "test:touchme-variants": "node scripts/test-touchme-variants.js",
    "test:presets": "node scripts/test-presets-idb.js",
    "test:service-worker-ready": "node scripts/test-service-worker-ready.js && node scripts/test-app-update.js",
    "test:midi-permission-cancel": "node scripts/test-midi-permission-cancel.js",
    "test:sound:soak:smoke": "node scripts/test-sound-browser.js --soak-seconds=60",
    "test:sound:soak": "node scripts/test-sound-browser.js --soak-seconds=600",
    "test:quick": "npm run lint && npm run test:architecture && npm run test:listeners && npm run test:midi-timing && npm run test:settings-readback && npm run test:diagnostics && npm run test:telemetry && npm run test:release-evidence && npm run test:preview-guard && npm run test:legacy-selector && npm run test:playtron-variants && npm run test:scales-variants && npm run test:touchme-variants && npm run test:presets && npm run test:service-worker-ready && npm run test:midi-permission-cancel && npm run test:sound && npm run test:sound:levels && npm run test:auditions && npm run test:auditions:render && npm run test:navigation && npm run test:compatibility",
    "test:beta-build": "npm run build:biotron-beta && npm run test:device-scope && npm run test:midi-lifecycle && npm run test:pwa && npm run test:firmware",
    "test:build-destination": "node scripts/test-build-destination.js",
    "test:firmware:browser": "npm run build:biotron-firmware-beta && node scripts/test-firmware-modal-browser.js",
    "test:browser": "npm run test:sound:browser && npm run test:pwa:browser && npm run test:quality:browser && npm run test:auditions:browser && npm run test:playtron-variants:browser && npm run test:scales-variants:browser && npm run test:touchme-variants:browser",
    "test:biotron": "npm run test:quick && npm run test:production-isolation && npm run test:firmware:browser && npm run test:beta-build && npm run test:browser",
    "test:garden": "node scripts/test-garden-fullscreen.cjs",
    "test:audio-qa": "node scripts/audio-qa/test-analyze.mjs",
    "test:audio:realtime": "node scripts/audio-qa/test-analyze.mjs --browser",
    "test:qa-runner": "PYTHONDONTWRITEBYTECODE=1 /opt/homebrew/bin/python3 scripts/test-qa-runner.py",
    "test:auditions": "node --test scripts/test-audition-banks.mjs",
    "test:auditions:render": "node scripts/test-audition-render.js",
    "test:auditions:browser": "node scripts/test-audition-browser.js"
  },
  "dependencies": {
    "@elemaudio/core": "^4.0.1",
    "@elemaudio/web-renderer": "4.0.3",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@popperjs/core": "^2.11.8",
    "@progress/kendo-file-saver": "^1.1.1",
    "@vueform/slider": "^2.1.10",
    "bootstrap": "^5.3.2",
    "core-js": "^3.8.3",
    "multi-range-slider-vue": "^1.1.4",
    "vue": "^3.2.26",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@babel/core": "^7.12.16",
    "@babel/eslint-parser": "^7.12.16",
    "@elemaudio/offline-renderer": "^4.0.3",
    "@vue/cli-plugin-babel": "~5.0.0",
    "@vue/cli-plugin-eslint": "~5.0.0",
    "@vue/cli-plugin-pwa": "~5.0.0",
    "@vue/cli-service": "~5.0.0",
    "eslint": "^7.32.0",
    "eslint-plugin-vue": "^8.0.3",
    "playwright-core": "^1.62.1",
    "sass": "^1.77.0",
    "sass-loader": "^16.0.0"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/vue3-essential",
      "eslint:recommended"
    ],
    "parserOptions": {
      "parser": "@babel/eslint-parser"
    },
    "rules": {
      "vue/no-parsing-error": [
        "error",
        {
          "control-character-reference": false
        }
      ]
    }
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ]
}
